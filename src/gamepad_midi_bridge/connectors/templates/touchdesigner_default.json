    {"name": "face_north",  "note": 65, "source": "button 3"},
    {"name": "shoulder_l1", "note": 67, "source": "button 4"},
    {"name": "shoulder_r1", "note": 69, "source": "button 5"},
    {"name": "select",      "note": 71, "source": "button 6"},
    {"name": "start",       "note": 72, "source": "button 7"},
    {"name": "ps_home",     "note": 74, "source": "button 8"},
    {"name": "stick_l_click","note": 76, "source": "button 9"},
    {"name": "stick_r_click","note": 77, "source": "button 10"},
    {"name": "dpad_up",     "note": 78, "source": "hat up"},
