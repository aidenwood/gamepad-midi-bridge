    color: #f5f7fa;
}


/* ===================================================================
 * 14. WORKSPACE — TEMPLATE BUILDER TAB
 * File: template_builder_tab.py
 * Visual mapping diagram + binding form + starter-templates strip.
 * NOTE: per-template tag colours stay data-driven in Python — the tag
 * chip + Apply button take their accent from a runtime palette so the
 * card hover ring also matches the tag colour.
