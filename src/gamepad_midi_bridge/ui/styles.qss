/* ===================================================================
 * Universal Controller MIDI — Central Stylesheet
 * Single source of truth for every visual rule in the app.
 *
 * Editing this file is the supported way to retheme the app. Every
 * widget that needs a custom look has been given a stable objectName
 * (camelCase) so the QSS selectors below target one widget cleanly.
 *
 * EXCEPTIONS (rules that intentionally stay inline in Python):
 *   1. QSplitter handles — global QSplitter::handle QSS breaks drag on
 *      macOS Qt 6. The three splitters in main_window.py keep per-widget
 *      setStyleSheet calls with comments explaining why.
 *   2. UIButton / UILabel / UIInput / UICard / UIChromeFrame primitives
 *      in src/gamepad_midi_bridge/ui/primitives/ — these self-style at
 *      construction as defence-in-depth against the macOS translucent-
 *      ancestor paint bug (cascade dies under WA_TranslucentBackground).
 *      Documented in each primitive's docstring.
 *   3. State-dependent runtime restyling (e.g. _activity_dot teal/grey
 *      pulse, MIDI rate label colour swap) — kept inline because the
 *      values change every frame.
 *   4. Per-instance dynamic colour (template tag accents, connector
 *      verify chips) where the colour is data-driven from runtime info.
 *
 * Token reference (mirror of src/gamepad_midi_bridge/ui/tokens.py):
 *   Backgrounds:  BG_BASE #0c0d10 · BG_SURFACE #15171d
 *                 BG_ELEVATED #1d2028 · BG_HOVER #22242c
 *                 BG_PRESSED #2a2d36
 *   Chrome:       #0e0f12 (app shell) · #16181d (chrome surfaces)
 *                 #11131a (sunken cards) · #1f232b (subtle border)
 *   Text:         TEXT_PRIMARY #f5f7fa · TEXT_SECONDARY #c2c6cc
 *                 TEXT_MUTED #8a9099 · TEXT_DISABLED #5a606b
 *   Accent:       ACCENT_TEAL #2dd4bf · TEAL_LIGHT #5eead4
 *                 ACCENT_CORAL #f87171 · ACCENT_RED #f97373
 *                 ACCENT_ORANGE #f97316 · ACCENT_AMBER #fbbf24
 *                 ACCENT_BLUE #3b82f6 · ACCENT_BLUE_LIGHT #93c5fd
 *   Borders:      BORDER_SUBTLE #24262d · BORDER_STRONG #3a3d46
 *                 BORDER_DIVIDER #2c313b
 * =================================================================== */


/* ===================================================================
 * 1. GLOBAL BASE STYLES
 * QWidget defaults — fonts, base colours, every-widget chrome.
 * =================================================================== */

QWidget {
    background-color: #0e0f12;
    color: #e6e8eb;
    font-family: -apple-system, "Segoe UI", "SF Pro Text", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0e0f12;
}

QFrame#ChromeWidget {
    background-color: #0c0d10;
}

QPushButton {
    background-color: #1f232b;
    border: 1px solid #2c313b;
    border-radius: 6px;
    padding: 8px 16px;
    color: #e6e8eb;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #272c36;
    border-color: #3a414e;
}
QPushButton:pressed {
    background-color: #1a1d24;
}
QPushButton:disabled {
    color: #5a606b;
    background-color: #161920;
}

QPushButton#PrimaryButton {
    background-color: #2dd4bf;
    color: #0e0f12;
    border: none;
}
QPushButton#PrimaryButton:hover {
    background-color: #4ae0cd;
}
QPushButton#PrimaryButton:disabled {
    background-color: #1a4d47;
    color: #5a606b;
}

QPushButton#StopButton {
    background-color: #f97373;
    color: #0e0f12;
    border: none;
}
QPushButton#StopButton:hover {
    background-color: #fb8b8b;
}

QGroupBox {
    border: 1px solid #24262d;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 12px;
    color: #c2c6cc;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #8a9099;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QProgressBar {
    border: 1px solid #24262d;
    border-radius: 4px;
    background-color: #16181d;
    text-align: center;
    color: #e6e8eb;
}
QProgressBar::chunk {
    background-color: #2dd4bf;
    border-radius: 3px;
}

QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 4px;
    padding: 6px 8px;
    color: #e6e8eb;
}
QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #2dd4bf;
}

QListWidget {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
    padding: 4px;
}
QListWidget::item {
    padding: 8px 10px;
    border-radius: 4px;
}
QListWidget::item:selected {
    background-color: #1f3a36;
    color: #2dd4bf;
}

QTableWidget {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
    gridline-color: #24262d;
}

QHeaderView::section {
    background-color: #1a1d24;
    color: #8a9099;
    border: none;
    padding: 8px;
    font-weight: 600;
}


/* ===================================================================
 * 2. TAB NAVIGATION
 * Files: responsive_tab_widget.py + main_window.py (_build_tabs)
 * =================================================================== */

QTabWidget::pane {
    border: none;
    background-color: #0e0f12;
}

QTabBar::tab {
    background-color: transparent;
    color: #8a9099;
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}
QTabBar::tab:selected {
    color: #f5f7fa;
    border-bottom: 2px solid #2dd4bf;
}
QTabBar::tab:hover {
    color: #c2c6cc;
}


/* ===================================================================
 * 3. TOP STATUS BAR (chrome)
 * File: main_window.py (_build_status_bar)
 * Header strip: title/sub/rate/activity-dot + Start/Stop/Panic + layout
 * toggle chips (Split, Console, Inspect, 3D, A-, A+) + Record.
 * =================================================================== */

QFrame#StatusBar {
    background-color: #0e0f12;
    border-bottom: 1px solid #1c1e25;
}

QLabel#StatusTitle {
    color: #f5f7fa;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatusSub {
    color: #5a606b;
    font-size: 11px;
}

QLabel#StatusRateLabel {
    color: #8a9099;
    font-size: 10px;
    font-family: ui-monospace, Menlo, monospace;
}

/* ActivityDot — base style. Live state is teal (active) vs grey
 * (idle); the colour swap is driven at runtime in main_window.py so
 * those two stylesheets stay inline. */
QLabel#ActivityDot {
    color: #2c313b;
    font-size: 14px;
}

QPushButton#PanicButton {
    color: #f97316;
    font-weight: 700;
}

/* Record button — colour cycles checked/unchecked via objectName. */
QPushButton#RecordButton {
    color: #8a9099;
}
QPushButton#RecordButton:checked {
    color: #ef4444;
    font-weight: 700;
}

/* Status-bar dividers (vertical hairlines between groups). */
QFrame#StatusDivider {
    color: #2c313b;
}

/* Figma-style layout toggles — flat chips on the right of the header.
 * Vertical padding is intentionally tiny (3px) — these all use
 * setFixedHeight in Python and any more padding clips the label on
 * macOS Qt 6. Don't change this number without re-testing every
 * status bar mode. */
QPushButton#LayoutToggle {
    background-color: transparent;
    color: #8a9099;
    border: 1px solid #24262d;
    border-radius: 6px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
QPushButton#LayoutToggle:hover {
    color: #c2c6cc;
    border-color: #3a3e48;
    background-color: rgba(255, 255, 255, 0.03);
}
QPushButton#LayoutToggle:checked {
    color: #5eead4;
    border-color: rgba(45, 212, 191, 0.4);
    background-color: rgba(45, 212, 191, 0.10);
}
QPushButton#LayoutToggle:checked:hover {
    background-color: rgba(45, 212, 191, 0.16);
}


/* ===================================================================
 * 4. UPDATE BANNER (chrome)
 * File: main_window.py (_build_update_banner)
 * Slim teal strip shown when a new version is available.
 * =================================================================== */

QFrame#UpdateBanner {
    background-color: #1f3a36;
    border-bottom: 1px solid #2dd4bf;
}

QLabel#UpdateBannerLabel {
    color: #2dd4bf;
    font-weight: 500;
}

QPushButton#UpdateBannerOpenButton {
    color: #0e0f12;
    background-color: #2dd4bf;
}

QPushButton#UpdateBannerDismissButton {
    color: #2dd4bf;
}


/* ===================================================================
 * 5. SIDE PANEL + SPLIT VIEW PICKER
 * File: main_window.py (_build_side_panel)
 * Right-docked panel that mirrors a chosen tab next to the active one.
 * =================================================================== */

QLabel#SplitViewHeader {
    color: #5a606b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
}

QComboBox#SplitViewPicker {
    color: #c2c6cc;
    background-color: #0e0f12;
    border: 1px solid #2c313b;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
}
QComboBox#SplitViewPicker::drop-down {
    border: none;
}


/* ===================================================================
 * 6. LIVE TAB — PRO NUDGE
 * File: main_window.py (_build_tabs / Live)
 * Amber pill that appears when a 2nd controller is plugged into a
 * non-Pro install — invites the user to upgrade.
 * =================================================================== */

QLabel#ProNudgeLabel {
    color: #facc15;
    background: #2a2410;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
}


/* ===================================================================
 * 7. INSPECTOR PANEL
 * Files: inspector.py + inspector_renderers.py
 * Right-side context-properties drawer (Figma pattern).
 * =================================================================== */

QFrame#InspectorHeader {
    background-color: #16181d;
    border-bottom: 1px solid #24262d;
}

QLabel#InspectorTitle {
    color: #f5f7fa;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QPushButton#InspectorCloseButton {
    background: transparent;
    color: #8a9099;
    border: none;
    font-size: 16px;
}
QPushButton#InspectorCloseButton:hover {
    color: #f5f7fa;
}

QScrollArea#InspectorScroll {
    background: #0a0b0e;
    border: none;
}

QWidget#InspectorBodyHost {
    background: #0a0b0e;
}

/* Renderer chips & divider — emitted by inspector_renderers.py */
QLabel#InspectorKindChip {
    background-color: #1f3a36;
    color: #2dd4bf;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#InspectorKindChip[variant="live"] {
    background-color: #3a311a;
    color: #f5c450;
}

QLabel#InspectorAuthor {
    color: #8a9099;
    font-size: 11px;
}

QFrame#InspectorDivider {
    color: #24262d;
}

QFrame#InspectorRendererDivider {
    color: #1c1e25;
}

QLabel#InspectorStatusChip {
    background-color: #1d2028;
    color: #c2c6cc;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.4px;
}
QLabel#InspectorStatusChip[state="installed"] {
    background-color: #1f3a36;
    color: #2dd4bf;
}
QLabel#InspectorStatusChip[state="missing"] {
    background-color: #1d2028;
    color: #8a9099;
}


/* ===================================================================
 * 8. BOTTOM CONSOLE PANEL HEADER
 * File: log_console.py
 * Collapsible log dock — header strip + body scroll area.
 * =================================================================== */

QWidget#LogConsoleHeader {
    background-color: #16181d;
}

QLabel#LogConsoleTitle {
    color: #c2c6cc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QPushButton#LogConsoleClearButton {
    background-color: transparent;
    color: #8a9099;
    border: none;
    padding: 2px 6px;
    font-size: 11px;
}
QPushButton#LogConsoleClearButton:hover {
    color: #f5f7fa;
}

QPushButton#LogConsoleToggleButton {
    background-color: transparent;
    color: #c2c6cc;
    border: none;
    padding: 2px 8px;
    font-size: 12px;
}
QPushButton#LogConsoleToggleButton:hover {
    color: #f5f7fa;
}

QPlainTextEdit#LogConsoleBody {
    background-color: #0e0f12;
    color: #c2c6cc;
    border: none;
    selection-background-color: #1f3a36;
}


/* ===================================================================
 * 9. MIDI ACTIVITY LOG PANEL
 * File: midi_log_panel.py
 * Collapsible MIDI message stream — header + filter dropdown + list.
 * =================================================================== */

QWidget#MidiLogPanelHeader {
    background-color: #16181d;
}

QLabel#MidiLogPanelTitle {
    color: #c2c6cc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QComboBox#MidiLogPanelFilterCombo {
    background-color: #0e0f12;
    color: #c2c6cc;
    border: 1px solid #2c313b;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
}
QComboBox#MidiLogPanelFilterCombo::drop-down {
    border: none;
}

QPushButton#MidiLogPanelClearButton {
    background-color: transparent;
    color: #8a9099;
    border: none;
    padding: 2px 6px;
    font-size: 11px;
}
QPushButton#MidiLogPanelClearButton:hover {
    color: #f5f7fa;
}

QPushButton#MidiLogPanelToggleButton {
    background-color: transparent;
    color: #c2c6cc;
    border: none;
    padding: 2px 8px;
    font-size: 12px;
}
QPushButton#MidiLogPanelToggleButton:hover {
    color: #f5f7fa;
}

QListWidget#MidiLogPanelList {
    background-color: #0e0f12;
    color: #c2c6cc;
    border: none;
    selection-background-color: #1f3a36;
}


/* ===================================================================
 * 10. PRO LOCK OVERLAY
 * File: pro_lock.py
 * Semi-opaque blocker over Pro-gated tabs/dialogs.
 * =================================================================== */

QWidget#ProLockOverlay {
    background-color: rgba(14, 15, 18, 240);
}

QFrame#ProLockCard {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 12px;
    padding: 28px;
}

QLabel#ProBadge {
    background-color: #2dd4bf;
    color: #0e0f12;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#ProLockTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f5f7fa;
}

QLabel#ProLockSub {
    color: #8a9099;
    font-size: 13px;
}


/* ===================================================================
 * 11. RECONNECT OVERLAY
 * File: reconnect_overlay.py
 * Full-window blocker shown when a controller disconnects mid-session.
 * Title text restyles per state (scanning / found / failed) — those
 * three states are driven inline in Python because the colours change.
 * =================================================================== */

QWidget#ReconnectOverlay {
    background: rgba(10, 11, 14, 200);
}

QLabel#ReconnectTitle {
    color: #f5f7fa;
    font-size: 26px;
    font-weight: 700;
}
QLabel#ReconnectTitle[state="success"] {
    color: #2dd4bf;
}
QLabel#ReconnectTitle[state="failed"] {
    color: #f59e0b;
}

QLabel#ReconnectSubtitle {
    color: #8a9099;
    font-size: 14px;
}


/* ===================================================================
 * 12. ONBOARDING WIZARD
 * File: onboarding.py
 * Ten-step first-launch modal. Heading sizes pick "big" mode for the
 * welcome + done pages; everything else uses the standard heading.
 * =================================================================== */

QLabel#OnboardingHeading {
    font-size: 18px;
    font-weight: 600;
    color: #f5f7fa;
}

QLabel#OnboardingHeadingBig {
    font-size: 22px;
    font-weight: 700;
    color: #f5f7fa;
}

QLabel#OnboardingBody {
    color: #c2c6cc;
    font-size: 13px;
}

QLabel#OnboardingHint {
    color: #8a9099;
    font-size: 12px;
}

QLabel#OnboardingStatus {
    color: #c2c6cc;
}

/* Status colour swaps for the controller / midi probe — set via
 * dynamic property "state" (scanning|ok|error) so the inline restyle
 * goes away. main_window.py / onboarding.py set the property and call
 * style().polish(widget) after each change. */
QLabel#OnboardingStatus[state="ok"] {
    color: #2dd4bf;
}
QLabel#OnboardingStatus[state="error"] {
    color: #f97373;
}

QFrame#OnboardingConnectorRow {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
}

QCheckBox#OnboardingConnectorCheck {
    color: #f5f7fa;
    font-weight: 500;
}

QLabel#OnboardingConnectorDesc {
    color: #8a9099;
    font-size: 12px;
}

QLabel#OnboardingConnectorStatus {
    color: #2dd4bf;
    font-size: 12px;
}
QLabel#OnboardingConnectorStatus[state="missing"] {
    color: #8a9099;
}
QLabel#OnboardingConnectorStatus[state="error"] {
    color: #f97373;
}

QFrame#OnboardingTriggerModeRow {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
}

QLabel#OnboardingTriggerModeName {
    color: #2dd4bf;
    font-size: 12px;
    font-weight: 600;
}

QLabel#OnboardingTriggerModeDesc {
    color: #8a9099;
    font-size: 12px;
}

QLabel#OnboardingPolarDiagram {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
    padding: 10px;
    color: #2dd4bf;
    font-family: monospace;
    font-size: 12px;
}

QPushButton#OnboardingSkipLink {
    color: #8a9099;
    background: transparent;
    border: none;
}
QPushButton#OnboardingSkipLink:hover {
    color: #f5f7fa;
}

QFrame#OnboardingFooter {
    background-color: #16181d;
    border-top: 1px solid #24262d;
}


/* ===================================================================
 * 13. WORKSPACE — MAPPING EDITOR
 * File: mapping_editor.py
 * Mapping rows table + tip strip + close button + section divider.
 * =================================================================== */

QWidget#MappingTipStrip {
    background: #1c2d44;
    border-radius: 4px;
}

QLabel#MappingTipIcon {
    font-size: 16px;
    color: #3b82f6;
    background: transparent;
}

QLabel#MappingTipText {
    color: #93c5fd;
    font-size: 11px;
    background: transparent;
}

QPushButton#MappingTipCloseButton {
    background: transparent;
    border: none;
    color: #93c5fd;
    font-size: 14px;
    padding: 0;
}
QPushButton#MappingTipCloseButton:hover {
    color: #3b82f6;
}

QFrame#MappingDivider {
    color: #1c1e25;
}

QLabel#MappingSectionLabel {
    color: #8a9099;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QPushButton#MappingActionChip {
    background-color: #16181d;
    color: #c2c6cc;
    border: 1px solid #24262d;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
}
QPushButton#MappingActionChip:hover {
