    font-size: 11px;
}


/* ===================================================================
 * 25. HUD OVERLAY
 * File: hud_overlay.py
 * On-screen overlay shown over the bridge while performing.
 * Status-dot colour is driven at runtime (active/idle/error) — those
 * three states stay inline because they swap every disconnect tick.
 * =================================================================== */

QLabel#HudPresetLabel {
    color: #f5f7fa;
    font-size: 13px;
    font-weight: 600;
}

QLabel#HudThroughputLabel {
    color: #8a9099;
    font-size: 11px;
    font-family: ui-monospace, Menlo, monospace;
}


/* ===================================================================
 * 26. MARKETPLACE TAB
 * File: marketplace_tab.py
 * Preset cards with tag chips — chip backgrounds vary by tag (runtime).
 * =================================================================== */

QFrame#MarketplaceCard {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 8px;
}
QFrame#MarketplaceCard:hover {
    border-color: #3a3e48;
}


/* ===================================================================
 * 27. RESPONSIVE TAB WIDGET
 * File: responsive_tab_widget.py
 * Wraps QTabBar — pinches to a QComboBox at narrow widths.
 * =================================================================== */

QComboBox#ResponsiveTabPickerCombo {
    background: #0e0f12;
    color: #f5f7fa;
    border: 1px solid #2c313b;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
}
QComboBox#ResponsiveTabPickerCombo::drop-down {
    border: none;
}

QTabBar#ResponsiveTabBar::tab {
    min-width: 0;
    padding: 8px 14px;
}


/* ===================================================================
 * 28. SETTINGS PANEL — DANGER ZONE
 * File: settings_panel.py
 * Red-tinted group box for reset-everything style actions.
 * =================================================================== */

QGroupBox#SettingsDangerZone {
    border: 1px solid #c0392b;
    border-radius: 4px;
    margin-top: 18px;
    padding-top: 12px;
}
QGroupBox#SettingsDangerZone::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #c0392b;
}

/* Search-filter highlight on settings groups. */
QGroupBox[searchState="match"] {
    border: 2px solid #1abc9c;
    border-radius: 4px;
}
QGroupBox[searchState="match"]::title {
    font-weight: bold;
    color: #1abc9c;
}
QGroupBox[searchState="dim"] {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
}
QGroupBox[searchState="dim"]::title {
    color: #7f8c8d;
}


/* ===================================================================
 * 29. THROUGHPUT PANEL FRAME
 * File: throughput_panel.py
 * =================================================================== */

QWidget#ThroughputPanel {
    background: #0e0f12;
    border: 1px solid #1c1e25;
    border-radius: 6px;
}


/* ===================================================================
 * 30. USAGE HEATMAP CONTROLS
 * File: usage_heatmap.py
 * =================================================================== */

QLabel#UsageHeatmapLabel {
    color: #8a9099;
    font-size: 11px;
}

QLabel#UsageHeatmapTitle {
    color: #8a9099;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QPushButton#UsageHeatmapResetButton {
    background: #1f232b;
    color: #8a9099;
    border: 1px solid #2c313b;
    border-radius: 4px;
    font-size: 10px;
    padding: 4px 10px;
}
QPushButton#UsageHeatmapResetButton:hover {
    background: #262b35;
    color: #d0d4dc;
}

QLabel#UsageHeatmapTop5Title {
    color: #5a606b;
    font-size: 9px;
    font-weight: 600;
}


/* ===================================================================
 * Global scrollbars — minimal style, slim track, soft thumb.
 * =================================================================== */

QScrollBar:vertical {
    background: #0e0f12;
    width: 12px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #2c313b;
    border-radius: 3px;
    min-height: 24px;
    margin: 2px 3px;
}
QScrollBar::handle:vertical:hover {
    background: #3a414e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    height: 12px;
    subcontrol-origin: margin;
    border: none;
}
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background: transparent;
    width: 7px;
    height: 7px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #0e0f12;
    height: 12px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #2c313b;
    border-radius: 3px;
    min-width: 24px;
    margin: 3px 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #3a414e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: transparent;
    width: 12px;
    subcontrol-origin: margin;
    border: none;
}
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    background: transparent;
    width: 7px;
    height: 7px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}


/* ===================================================================
 * SPLITTER HANDLES — INTENTIONALLY NOT STYLED HERE
 * Global QSS rules that customise QSplitter::handle break drag
 * dispatch on macOS Qt 6. The three splitters in main_window.py
 * (body_splitter, content_splitter, _live_splitter) own their look
 * via per-widget setStyleSheet calls in Python. Don't add a global
 * QSplitter::handle rule here — it will silently break dragging.
 * =================================================================== */
