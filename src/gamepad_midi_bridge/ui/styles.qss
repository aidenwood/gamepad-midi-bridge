    border-radius: 8px;
}

QLineEdit#CommandPaletteSearch {
    background-color: #0e0f12;
    color: #f5f7fa;
    border: 1px solid #24262d;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 14px;
}
QLineEdit#CommandPaletteSearch:focus {
    border-color: #2dd4bf;
}

QListWidget#CommandPaletteList {
    background-color: transparent;
    border: none;
