QFrame#HelpCard {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 10px;
}

QFrame#HelpFaqRow {
    background-color: #11131a;
    border: 1px solid #1f232b;
    border-radius: 8px;
}

QPushButton#HelpFaqToggle {
    text-align: left;
    padding: 12px 14px;
    background: transparent;
    border: none;
    color: #e6e8eb;
    font-weight: 500;
}
QPushButton#HelpFaqToggle:hover {
    color: #2dd4bf;
}

QLabel#HelpFaqAnswer {
    color: #c2c6cc;
    padding: 0 14px 14px 14px;
    font-size: 12px;
}

QWidget#HelpLogo3D {
    background: transparent;
    border: 0;
}

QLabel#HelpShortcutKey {
    color: #2dd4bf;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
    background: #11131a;
    border: 1px solid #1f232b;
    border-radius: 4px;
    padding: 4px 8px;
}

QLabel#HelpShortcutDesc {
    color: #e6e8eb;
}

QLabel#HelpBulletDot {
    color: #2dd4bf;
    font-size: 14px;
}

QLabel#HelpBulletText {
    color: #c2c6cc;
    font-size: 12px;
}

QLabel#HelpLinksNote {
    color: #8a9099;
    font-size: 12px;
}

QLabel#HelpVersionLabel {
    color: #8a9099;
    font-weight: 500;
    min-width: 100px;
}

QLabel#HelpVersionValue {
    color: #e6e8eb;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
}


/* ===================================================================
