    font-size: 14px;
    font-weight: 600;
}


/* ===================================================================
 * 16. WORKSPACE — BLUETOOTH TAB
 * File: bluetooth_tab.py
 * =================================================================== */

QLabel#BluetoothHeader {
    font-size: 14px;
    font-weight: 600;
    color: #f5f7fa;
}

QLabel#BluetoothSubLabel {
    color: #8a9099;
}

QPushButton#BluetoothDocsLink {
    color: #666;
    text-decoration: underline;
    background: transparent;
    border: none;
}

QLabel#BluetoothEmptyState {
    color: #8a9099;
    padding: 40px;
}

QFrame#BluetoothPairedDeviceCard {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 8px;
    padding: 14px;
}

QLabel#BluetoothPairedDeviceTitle {
    font-size: 14px;
    font-weight: 600;
    color: #f5f7fa;
}

QLabel#BluetoothPairedDeviceMeta {
    color: #8a9099;
    font-size: 12px;
}

QLabel#BluetoothPairedDeviceStatus {
    color: #8a9099;
    font-size: 12px;
    font-weight: 600;
}
QLabel#BluetoothPairedDeviceStatus[state="connected"] {
    color: #2dd4bf;
}


/* ===================================================================
 * 17. WORKSPACE — CONNECTORS TAB
 * File: connectors_tab.py
 * Install-host cards (Ableton, Resolume, etc.) with verify chips.
 * =================================================================== */

QLabel#ConnectorsSectionTitle {
    color: #f5f7fa;
    font-size: 14px;
    font-weight: 600;
}

QFrame#ConnectorsSeparator {
    color: #24262d;
    margin: 6px 0;
}

QFrame#ConnectorsHostCard {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 8px;
    padding: 14px;
}

QFrame#ConnectorsTemplateCard {
    background-color: #0f1117;
    border: 1px solid #1e2029;
    border-radius: 6px;
}

QLabel#ConnectorsStatusLabel {
    color: #8a9099;
    font-size: 12px;
}

QLabel#ConnectorsVerifyChip {
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    background-color: #1d2028;
    color: #c2c6cc;
}
QLabel#ConnectorsVerifyChip[verifyState="ok"] {
    background-color: #1f3a36;
    color: #2dd4bf;
}
QLabel#ConnectorsVerifyChip[verifyState="fail"] {
    background-color: #3a1f1f;
    color: #f97373;
}

QLabel#ConnectorsChip {
    background-color: #1d2028;
    color: #c2c6cc;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}


/* ===================================================================
