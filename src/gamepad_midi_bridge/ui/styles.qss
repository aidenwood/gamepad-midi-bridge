/* Universal Controller MIDI — dark theme.
   Targets standard QWidget classes so the file works without per-widget objectName. */

QWidget {
    background-color: #0e0f12;
    color: #e6e8eb;
    font-family: -apple-system, "Segoe UI", "SF Pro Text", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0e0f12;
}

QFrame#StatusBar {
    background-color: #16181d;
    border-bottom: 1px solid #24262d;
    padding: 14px 18px;
}

QLabel#StatusTitle {
    font-size: 15px;
    font-weight: 600;
    color: #f5f7fa;
}

QLabel#StatusSub {
    color: #8a9099;
    font-size: 12px;
}

QLabel#ActivityDot {
    color: #2dd4bf;
    font-size: 18px;
}

QPushButton {
    background-color: #1f232b;
    border: 1px solid #2c313b;
    border-radius: 6px;
    padding: 8px 16px;
    color: #e6e8eb;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #272c36;
    border-color: #3a414e;
}

QPushButton:pressed {
    background-color: #1a1d24;
}

QPushButton:disabled {
    color: #5a606b;
    background-color: #161920;
}

QPushButton#PrimaryButton {
    background-color: #2dd4bf;
    color: #0e0f12;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #4ae0cd;
}

QPushButton#PrimaryButton:disabled {
    background-color: #1a4d47;
    color: #5a606b;
}

QPushButton#StopButton {
    background-color: #f97373;
    color: #0e0f12;
    border: none;
}

QPushButton#StopButton:hover {
    background-color: #fb8b8b;
}

/* Figma-style layout toggles — flat chips in the right side of the header.
   Sit alongside Start/Stop but feel less primary, more like editor tools.
   Vertical padding is ZERO because these buttons all use ``setFixedHeight``
   in Python — non-zero vertical padding overflows the fixed height on
   macOS Qt 6 and clips the label. Width padding (11 px) is fine. */
QPushButton#LayoutToggle {
    background-color: transparent;
    color: #8a9099;
    border: 1px solid #24262d;
    border-radius: 6px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}

QPushButton#LayoutToggle:hover {
    color: #c2c6cc;
    border-color: #3a3e48;
    background-color: rgba(255, 255, 255, 0.03);
}

QPushButton#LayoutToggle:checked {
    color: #5eead4;
    border-color: rgba(45, 212, 191, 0.4);
    background-color: rgba(45, 212, 191, 0.10);
}

QPushButton#LayoutToggle:checked:hover {
    background-color: rgba(45, 212, 191, 0.16);
}

QTabWidget::pane {
    border: none;
    background-color: #0e0f12;
}

QTabBar::tab {
    background-color: transparent;
    color: #8a9099;
    padding: 10px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #f5f7fa;
    border-bottom: 2px solid #2dd4bf;
}

QTabBar::tab:hover {
    color: #c2c6cc;
}

QLabel#ProLockTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f5f7fa;
}

QLabel#ProLockSub {
    color: #8a9099;
    font-size: 13px;
}

QFrame#ProBadge {
    background-color: #2dd4bf;
    color: #0e0f12;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

QGroupBox {
    border: 1px solid #24262d;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 12px;
    color: #c2c6cc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #8a9099;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QProgressBar {
    border: 1px solid #24262d;
    border-radius: 4px;
    background-color: #16181d;
    text-align: center;
    color: #e6e8eb;
}

QProgressBar::chunk {
    background-color: #2dd4bf;
    border-radius: 3px;
}

QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 4px;
    padding: 6px 8px;
    color: #e6e8eb;
}

QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #2dd4bf;
}

QListWidget {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #1f3a36;
    color: #2dd4bf;
}

QTableWidget {
    background-color: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
    gridline-color: #24262d;
}

QHeaderView::section {
    background-color: #1a1d24;
    color: #8a9099;
    border: none;
    padding: 8px;
    font-weight: 600;
}

/* QSplitter handles intentionally NOT styled here — global QSS that
 * customises the handle's background-color breaks dragging on macOS Qt 6
 * (Qt stops dispatching mouse events to the styled handle). Splitter
 * sizing is owned by ``setHandleWidth()`` on each splitter; appearance
 * uses Qt's native rendering which is already visible enough. */

/* ----- Global scrollbars -----------------------------------------------
 * Minimal style — slim track, soft thumb, small chevron arrows. Matches
 * the splitter palette so the chrome reads as one consistent surface. */
QScrollBar:vertical {
    background: #0e0f12;
    width: 12px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #2c313b;
    border-radius: 3px;
    min-height: 24px;
    margin: 2px 3px;
}
QScrollBar::handle:vertical:hover {
    background: #3a414e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: transparent;
    height: 12px;
    subcontrol-origin: margin;
    border: none;
}
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background: transparent;
    width: 7px;
    height: 7px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: #0e0f12;
    height: 12px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #2c313b;
    border-radius: 3px;
    min-width: 24px;
    margin: 3px 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #3a414e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: transparent;
    width: 12px;
    subcontrol-origin: margin;
    border: none;
}
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    background: transparent;
    width: 7px;
    height: 7px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}
