    color: #f5f7fa;
}

QFrame#TemplateBuilderForm {
    background: #16181d;
    border: 1px solid #24262d;
    border-radius: 8px;
    padding: 10px;
}
QFrame#TemplateBuilderForm QLabel {
    color: #8a9099;
    font-size: 11px;
}

QPushButton#TemplateBuilderSaveBinding {
    background: #2dd4bf;
    color: #0e0f12;
    font-weight: 600;
    padding: 6px 12px;
    border: none;
    border-radius: 6px;
}
QPushButton#TemplateBuilderSaveBinding:hover {
    background: #4ae0cd;
}

QFrame#TemplatesPanel {
    background: #0e0f12;
    border: 1px solid #24262d;
    border-radius: 8px;
    padding: 6px;
}

QLabel#TemplatesPanelHeader {
    color: #f5f7fa;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QScrollArea#TemplatesPanelScroll {
    background: transparent;
    border: none;
}

QWidget#TemplatesPanelCardsHost {
    background: transparent;
}

QFrame#TemplateCard {
    background: #16181d;
    border: 1px solid #24262d;
    border-radius: 6px;
}
QFrame#TemplateCard:hover {
    border: 1px solid #2dd4bf;
}

QLabel#TemplateCardName {
