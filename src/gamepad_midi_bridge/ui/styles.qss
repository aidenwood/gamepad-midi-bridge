}

QScrollArea#VisualiseScopeScroll {
    border: none;
}

QLabel#VisualiseScopeHeading {
    color: #8a9099;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QFrame#VisualisePanelFrame {
